{
  "name": "aldott",
  "version": "1.0.0",
  "private": true,
  "description": "Aldott — independent wind energy engineering consultancy website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:admin": "npm --prefix admin run dev",
    "install:apps": "npm --prefix apps/api install && npm --prefix admin install",
    "api:generate": "npm --prefix apps/api run prisma:generate",
    "db:migrate": "npm --prefix apps/api run prisma:migrate",
    "db:deploy": "npm --prefix apps/api run prisma:deploy",
    "db:seed": "npm --prefix apps/api run seed",
    "neon:plan": "neon config plan --env .env --profile aldott-production --project-id misty-sky-58933950 --branch production",
    "neon:deploy": "neon deploy --env .env --profile aldott-production --project-id misty-sky-58933950 --branch production --no-env-pull"
  },
  "dependencies": {
    "@react-three/fiber": "^8.16.8",
    "lucide-react": "0.417.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@neon/config": "^1.10.0",
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "^0.161.2",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "neon": "^8.17.1",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
